{
  "name": "smart-expense-splitter",
  "version": "1.0.0",
  "description": "Smart Expense Splitter with CI/CD Pipeline for MIT-WPU TY CSE CCD/AIES LCA-2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "expense-splitter",
    "cicd",
    "docker",
    "jenkins",
    "github-actions",
    "render",
    "mit-wpu"
  ],
  "author": "MIT-WPU TY CSE Student",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "app.js"
    ]
  }
